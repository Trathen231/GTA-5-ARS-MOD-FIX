<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SDK-style net48 project (converted from the old-style csproj so it builds with `dotnet build`).
    Build:  dotnet build "ARS FIX.csproj" -c Release
    Output: bin\Release\net48\ARS.dll  (deploy as scripts\ARS\ARS.dll)

    ScriptHookVDotNet2.dll (v2 API) is NOT in the repo. Copy the one from your game folder to
    %USERPROFILE%\ars-ref\ScriptHookVDotNet2.dll, or pass -p:ShvdnDir=<folder containing it>.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ARS_FIX</RootNamespace>
    <AssemblyName>ARS</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0612</NoWarn>
    <ShvdnDir Condition="'$(ShvdnDir)' == ''">$(USERPROFILE)\ars-ref</ShvdnDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ScriptHookVDotNet2">
      <HintPath>$(ShvdnDir)\ScriptHookVDotNet2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AutosportRacingSystem.cs" />
    <Compile Include="ArsMemory.cs" />
    <Compile Include="DataStructures.cs" />
    <Compile Include="PersonalitySet.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Racer.cs" />
    <Compile Include="SkillSet.cs" />
  </ItemGroup>
</Project>
